[11.87, "o", "\u001b[38;5;253m{ \u001b[38;5;114m\"results\"\u001b[38;5;253m: [],\r\n"]
[11.93, "o", "  \u001b[38;5;114m\"confidence\"\u001b[38;5;253m: \u001b[38;5;210m\"low\"\u001b[38;5;253m,\r\n"]
[11.99, "o", "  \u001b[38;5;114m\"unmatchableTerms\"\u001b[38;5;253m: [\u001b[38;5;179m\"drink\"\u001b[38;5;253m, \u001b[38;5;179m\"afternoon\"\u001b[38;5;253m],\r\n"]
[12.05, "o", "  \u001b[38;5;114m\"bestWeak\"\u001b[38;5;253m: [ { \u001b[38;5;114m\"name\"\u001b[38;5;253m: \u001b[38;5;179m\"coffee-order\"\u001b[38;5;253m, \u001b[38;5;114m\"score\"\u001b[38;5;253m: \u001b[38;5;176m0.23\u001b[38;5;253m } ],\r\n"]
[12.11, "o", "  \u001b[38;5;114m\"absenceNote\"\u001b[38;5;253m: \u001b[38;5;179m\"No strong match: the terms that make this question\r\n"]
[12.17, "o", "                  specific appear NOWHERE in the corpus (drink, afternoon\r\n"]
[12.23, "o", "                  \u2014 100% of the query's discriminative weight, floor 40%).\r\n"]
[12.29, "o", "                  The documents under bestWeak are the nearest neighbours,\r\n"]
[13.29, "o", "                  NOT ranked answers.\"\u001b[38;5;253m }\u001b[0m\r\n"]
[14.89, "o", "\r\n"]
[15.69, "o", "\u001b[38;5;245m# the answer was there. it was not ranked first \u2014 it was labelled a weak candidate.\u001b[0m\r\n"]
